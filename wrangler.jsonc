{
  // Cloudflare Worker: serves the built PWA from dist/ and the API under /api/*.
  // Data: D1 in the EU jurisdiction — DB for records, PHOTOS for photo blobs.
  // Branch previews use their own databases (see "previews"), never production data.
  "name": "racknotes",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Production address; Cloudflare creates the DNS record on deploy.
  // Branch previews: https://<branch>.racknotes.asenkostov.eu (same Access policy).
  "routes": [{ "pattern": "racknotes.asenkostov.eu", "custom_domain": true, "previews_enabled": true }],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "racknotes", "database_id": "f38c6171-3c1e-4d0c-ac5b-fce70673b0bb" },
    { "binding": "PHOTOS", "database_name": "racknotes-photos-eu", "database_id": "c143bd3c-d8f8-41f5-8e20-b390ae73a904" }
  ],
  "previews": {
    "vars": {
      "ACCESS_TEAM": "https://square-fog-80c9.cloudflareaccess.com",
      "ACCESS_AUD": "56c7684e9662521c7661903e0821100fe1f9bcda70afa6bc9ed0a29bec5615ae"
    },
    "d1_databases": [
      { "binding": "DB", "database_name": "racknotes-preview", "database_id": "ddaddf51-a195-4ded-beae-22159bd81a7a" },
      { "binding": "PHOTOS", "database_name": "racknotes-photos-preview", "database_id": "a9dc37d0-3bc2-4235-bff4-358538f6261c" }
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Access: every API request must carry a valid token signed for this application.
  // Team URL and AUD tag are public identifiers, not secrets.
  "vars": {
    "ACCESS_TEAM": "https://square-fog-80c9.cloudflareaccess.com",
    "ACCESS_AUD": "56c7684e9662521c7661903e0821100fe1f9bcda70afa6bc9ed0a29bec5615ae"
  },
  "observability": { "enabled": true }
}
